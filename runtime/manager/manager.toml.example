# Prometheus Manager configuration — manager.toml
# Copy to manager.toml and edit. All settings have defaults.
# Implements: specs/008-llama-server-manager.md

[api]
# Manager REST API bind address and port.
# 0.0.0.0 allows containerised services (e.g. gateway in Podman) to reach the API via host.containers.internal.
# JWT authentication on every endpoint is the security boundary for the REST API.
host = "0.0.0.0"
port = 8090
# JWKS URL for validating JWTs issued by the Auth Service.
# 127.0.0.1 rather than localhost on purpose: localhost also resolves to ::1, and
# any other service on the machine bound to 0.0.0.0:9000 answers there first. When
# that happens the manager fetches something that isn't a JWKS and rejects every
# token as "invalid or expired", which points the investigation at credentials
# instead of at the port. Overridden by PMGR_JWKS_URL in container deployments.
jwks_url = "http://127.0.0.1:9000/.well-known/jwks.json"

[server]
# Path to the llama-server binary
binary = "~/.local/bin/llama-server"
# Host is always forced to 127.0.0.1 regardless of this setting (AC-19)
host = "127.0.0.1"
# Seconds to wait for /health to return 200 before killing the process (AC-5)
start_timeout_s = 60
# Seconds to wait after SIGTERM before sending SIGKILL (AC-7)
stop_timeout_s = 10
# Log files directory
log_dir = "runtime/logs"
# PID files directory
pid_dir = "runtime/run"

# PRM-134/PRM-152: the fleet — the list *of* nodes, and this node's place in it.
# The section was missing from this example, which is the file a new node is built
# from; a node built without it cannot report its own liveness.
[fleet]
# Exactly one manager-api in the fleet sets this. It opens `path` and serves
# /v1/fleet/nodes; every other node leaves it false and answers those endpoints
# with a 409 naming the coordinator.
coordinator = false
path = "runtime/manager/fleet.db"
# Where this node reports that it is up (PRM-152). Leave empty on the
# coordinator: it owns fleet.db and stamps its own row in process.
coordinator_url = ""
# Where this node mints its heartbeat token. Named rather than derived from
# `jwks_url` above, which is the same service today — a value that is right by
# coincidence is one that stops being right silently.
auth_token_url = ""
# Kubernetes' kubelet renews its Lease every 10s against a 40s duration; this is
# 10s against a 60s TTL, so several missed reports are needed before a node stops
# being routable.
heartbeat_interval_s = 10.0
# PRM-151's probe from the coordinator. On until every node reports in, then off:
# while a probe also stamps `last_seen_at`, "the node is down" and "I could not
# reach it" stay indistinguishable.
sweep = true
#
# The node's identity and credential are NOT in this file. One OAuth2 client per
# node, granted `fleet:heartbeat` and `node:<its id>`, supplied through the
# environment:
#
#   PMGR_FLEET_NODE_ID       the id the coordinator assigned this node at
#                            registration (a UUID — a node cannot derive it)
#   PMGR_FLEET_CLIENT_ID     its own OAuth2 client
#   PMGR_FLEET_CLIENT_SECRET that client's secret — never in a tracked file
#
# Missing any of them disables the heartbeat and logs which ones by name; the
# node still serves inference. See docs/local-stack.md.

[registry]
# Path to the manager registry.db — a SQLite database, source of truth for
# models (RM-49; a legacy registry.yaml next to this path is imported once,
# automatically, the first time this path doesn't exist yet).
path = "runtime/manager/registry.db"

[downloads]
# Directory where GGUF files are downloaded
dir = "runtime/models/downloads"
# Environment variable name containing the HuggingFace token
hf_token_env = "HF_TOKEN"
# PEM bundle for corporate TLS interception (e.g. Zscaler or similar proxy).
# Leave empty to let truststore use the OS native trust store (macOS Keychain,
# Windows CAPI, Linux system certs) — correct default for most machines.
# Only set this when your network proxy re-signs TLS AND its CA is NOT already
# installed in the system keychain (i.e. machines with a fully managed proxy).
# See specs/011-downloads-view-redesign.md — AC-22–AC-25
ca_bundle = ""

[dashboard]
# TUI refresh interval in seconds (AC-26)
refresh_interval_s = 2

[tui]
# Default theme for the TUI at startup.
# Any Textual built-in theme name is valid. Use Ctrl+P at runtime to switch themes
# and discover new ones. The change is live but not persisted — update this value
# to keep your preferred theme across restarts.
#
# Built-in options: textual-dark, textual-light, nord, gruvbox, catppuccin-mocha,
#   catppuccin-latte, catppuccin-frappe, catppuccin-macchiato, dracula, tokyo-night,
#   monokai, flexoki, solarized-light, solarized-dark, rose-pine, rose-pine-moon,
#   rose-pine-dawn, atom-one-dark, atom-one-light, github-dark (Prometheus custom)
theme = "catppuccin-latte"

# Log file for the TUI session.
# While Textual owns the terminal stdout is silenced; logs are written here instead.
# Follow live with: tail -f runtime/logs/manager.log
# Set to "" to discard all logs during the TUI session.
log_file_path = "runtime/logs/manager.log"
