# Telemetry identity for a bare-metal launch — RM-94
#
# `source` this before starting a service, or point systemd's EnvironmentFile at
# a copy. It exists because these are process environment variables read by the
# OpenTelemetry SDK, not application settings: a service's own .env is parsed by
# pydantic-settings and never reaches os.environ, so putting them there does
# nothing at all.
#
#   cp runtime/telemetry.env.example runtime/telemetry.env
#   set -a && . runtime/telemetry.env && set +a
#   OTEL_SERVICE_NAME=gateway .venv/bin/uvicorn prometheus_gateway.asgi:app ...
#
# OTEL_SERVICE_NAME is deliberately absent: it differs per process, and each
# service already names itself in code (gateway, auth-service, manager-api,
# manager-tui). Set it only to override.

# Argus's collector. Unset means export nowhere — there is no default endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# What groups our components into one platform, so "how is Prometheus doing?" is
# answerable rather than only "how is auth-service doing?".
OTEL_RESOURCE_ATTRIBUTES=service.namespace=prometheus-inference-platform,argus.component.role=api,deployment.environment.name=bare-metal,service.version=2.0.0

# A-11: emit both the old and the stable HTTP attribute names during the
# transition. Our spans carried only the pre-2023 names (http.method,
# http.status_code, http.url), so our traffic was invisible to every aggregation
# built on the stable ones (http.request.method, url.full, server.address).
# "http/dup" rather than "http" so anything still reading the old names keeps
# working; switch to "http" once nothing does.
OTEL_SEMCONV_STABILITY_OPT_IN=http/dup

# A-12: set per process, not here — with replicas, one dead instance is
# invisible when they share an identity. That is P-04 at another scale.
#   OTEL_RESOURCE_ATTRIBUTES=",service.instance.id=gateway-1"
