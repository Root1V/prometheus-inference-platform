# runtime/env/mac-llama3-1b.env
# Environment for running Llama 3.2 1B Instruct on macOS (Metal / Apple Silicon).
#
# This is the recommended model for local gateway development and testing:
#   - 737 MB — fits in RAM/VRAM even on 8 GB M2 Macs
#   - Llama 3 instruction format — same family as production models
#   - Fast enough for iterative gateway testing (< 1 s first token on M2)
#
# Usage:
#   source runtime/env/mac-llama3-1b.env
#   bash runtime/scripts/start-server.sh
#
# The model ID below (PROMETHEUS_MODEL_ALIAS) matches the registry entry:
#   runtime/models/registry.yaml → id: "llama3-1b-q4-local"
# This is the value clients send in the "model" field of chat completions requests.

# ── Model ─────────────────────────────────────────────────────────────────────
export PROMETHEUS_MODEL_PATH="/Users/${USER}/Library/Application Support/nomic.ai/GPT4All/Llama-3.2-1B-Instruct-Q4_0.gguf"

# Model alias — must match "id" in runtime/models/registry.yaml
export PROMETHEUS_MODEL_ALIAS="llama3-1b-q4-local"

# ── Performance ───────────────────────────────────────────────────────────────
# -1 = all transformer layers on Metal GPU (recommended for Apple Silicon)
export PROMETHEUS_GPU_LAYERS=-1

# Context window — 4096 is enough for gateway integration tests
export PROMETHEUS_CTX_SIZE=4096

# ── Tracing ───────────────────────────────────────────────────────────────────
# TUI corre en bare-metal — Tempo expone 4318 al host vía port-forward de Podman
export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Para deshabilitar trazas sin cambiar código: export OTEL_SDK_DISABLED=true

# ── Server ────────────────────────────────────────────────────────────────────
export PROMETHEUS_LLAMA_PORT=8080
