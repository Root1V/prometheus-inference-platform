#!/usr/bin/env bash
# Pre-push hook — runs automatically before every `git push`.
# Blocks the push if any check fails.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# See: .github/instructions/sdd.instructions.md — "Pre-push Validation"

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
GATEWAY_DIR="$ROOT/gateway"
AUTH_DIR="$ROOT/auth-service"
RUNTIME_DIR="$ROOT/runtime"
MANAGER_DIR="$ROOT/runtime/manager"
TELEMETRY_DIR="$ROOT/telemetry"

echo "--- Pre-push validation ---"

# ── gateway ───────────────────────────────────────────────────────────────────
echo "[gateway 1/3] Lint (ruff check)"
uv run --project "$GATEWAY_DIR" ruff check "$GATEWAY_DIR"

echo "[gateway 2/3] Format (ruff format --check)"
uv run --project "$GATEWAY_DIR" ruff format --check "$GATEWAY_DIR"

echo "[gateway 3/3] Type check (mypy)"
uv run --project "$GATEWAY_DIR" mypy --config-file "$GATEWAY_DIR/pyproject.toml" "$GATEWAY_DIR/src"

# ── auth-service ──────────────────────────────────────────────────────────────
echo "[auth-service 1/3] Lint (ruff check)"
uv run --project "$AUTH_DIR" ruff check "$AUTH_DIR"

echo "[auth-service 2/3] Format (ruff format --check)"
uv run --project "$AUTH_DIR" ruff format --check "$AUTH_DIR"

echo "[auth-service 3/3] Type check (mypy)"
uv run --project "$AUTH_DIR" mypy --config-file "$AUTH_DIR/pyproject.toml" "$AUTH_DIR/src"

# ── telemetry ─────────────────────────────────────────────────────────────────
echo "[telemetry 1/3] Lint (ruff check)"
uv run --project "$TELEMETRY_DIR" ruff check "$TELEMETRY_DIR"

echo "[telemetry 2/3] Format (ruff format --check)"
uv run --project "$TELEMETRY_DIR" ruff format --check "$TELEMETRY_DIR"

echo "[telemetry 3/3] Type check (mypy)"
uv run --project "$TELEMETRY_DIR" mypy --config-file "$TELEMETRY_DIR/pyproject.toml" "$TELEMETRY_DIR/src"

# ── runtime/manager ───────────────────────────────────────────────────────────
# NOTE: no mypy step here on purpose. pyproject.toml declares strict = true but it
# was never actually enforced — there are ~86 pre-existing errors (mostly missing
# annotations in cli/main.py). Paying that down is folded into
# memory/roadmap.md RM-05 (splitting manager's TUI from its REST API), which
# restructures these same files anyway. See RM-02 in the roadmap for context.
echo "[manager 1/2] Lint (ruff check)"
uv run --project "$MANAGER_DIR" ruff check "$MANAGER_DIR"

echo "[manager 2/2] Format (ruff format --check)"
uv run --project "$MANAGER_DIR" ruff format --check "$MANAGER_DIR"

# ── tests ─────────────────────────────────────────────────────────────────────
echo "[tests 1/5] gateway (pytest)"
uv run --project "$GATEWAY_DIR" pytest "$GATEWAY_DIR/tests" -v --tb=short \
  --cov="$GATEWAY_DIR/src" --cov-report=term-missing --cov-fail-under=80

echo "[tests 2/5] auth-service (pytest)"
(cd "$AUTH_DIR" && uv run pytest tests/ -v --tb=short)

echo "[tests 3/5] telemetry (pytest)"
uv run --project "$TELEMETRY_DIR" pytest "$TELEMETRY_DIR/tests" -v --tb=short \
  --cov="$TELEMETRY_DIR/src" --cov-report=term-missing --cov-fail-under=90

echo "[tests 4/5] runtime/manager (pytest)"
uv run --project "$MANAGER_DIR" pytest "$MANAGER_DIR/tests" -v --tb=short

echo "[tests 5/5] runtime scripts (bash)"
bash "$RUNTIME_DIR/tests/test_runtime_scripts.sh"

echo "[tests 6/6] scripts/ (bash — spec 023)"
bash "$ROOT/scripts/tests/test_scripts_023.sh"

echo "--- All checks passed. Push allowed. ---"
