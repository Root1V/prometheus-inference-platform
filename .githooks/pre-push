#!/usr/bin/env bash
# Pre-push hook — runs automatically before every `git push`.
# Blocks the push if any check fails.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# See: .github/instructions/sdd.instructions.md — "Pre-push Validation"

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
GATEWAY_DIR="$ROOT/gateway"
AUTH_DIR="$ROOT/auth-service"
RUNTIME_DIR="$ROOT/runtime"
MANAGER_CORE_DIR="$ROOT/runtime/manager/core"
MANAGER_API_DIR="$ROOT/runtime/manager/api"
MANAGER_TUI_DIR="$ROOT/runtime/manager/tui"
TELEMETRY_DIR="$ROOT/telemetry"

echo "--- Pre-push validation ---"

# ── gateway ───────────────────────────────────────────────────────────────────
echo "[gateway 1/3] Lint (ruff check)"
uv run --project "$GATEWAY_DIR" ruff check "$GATEWAY_DIR"

echo "[gateway 2/3] Format (ruff format --check)"
uv run --project "$GATEWAY_DIR" ruff format --check "$GATEWAY_DIR"

echo "[gateway 3/3] Type check (mypy)"
uv run --project "$GATEWAY_DIR" mypy --config-file "$GATEWAY_DIR/pyproject.toml" "$GATEWAY_DIR/src"

# ── auth-service ──────────────────────────────────────────────────────────────
echo "[auth-service 1/3] Lint (ruff check)"
uv run --project "$AUTH_DIR" ruff check "$AUTH_DIR"

echo "[auth-service 2/3] Format (ruff format --check)"
uv run --project "$AUTH_DIR" ruff format --check "$AUTH_DIR"

echo "[auth-service 3/3] Type check (mypy)"
uv run --project "$AUTH_DIR" mypy --config-file "$AUTH_DIR/pyproject.toml" "$AUTH_DIR/src"

# ── telemetry ─────────────────────────────────────────────────────────────────
echo "[telemetry 1/3] Lint (ruff check)"
uv run --project "$TELEMETRY_DIR" ruff check "$TELEMETRY_DIR"

echo "[telemetry 2/3] Format (ruff format --check)"
uv run --project "$TELEMETRY_DIR" ruff format --check "$TELEMETRY_DIR"

echo "[telemetry 3/3] Type check (mypy)"
uv run --project "$TELEMETRY_DIR" mypy --config-file "$TELEMETRY_DIR/pyproject.toml" "$TELEMETRY_DIR/src"

# ── runtime/manager (core / api / tui — split in RM-05) ────────────────────────
echo "[manager-core 1/3] Lint (ruff check)"
uv run --project "$MANAGER_CORE_DIR" ruff check "$MANAGER_CORE_DIR"

echo "[manager-core 2/3] Format (ruff format --check)"
uv run --project "$MANAGER_CORE_DIR" ruff format --check "$MANAGER_CORE_DIR"

echo "[manager-core 3/3] Type check (mypy)"
uv run --project "$MANAGER_CORE_DIR" mypy --config-file "$MANAGER_CORE_DIR/pyproject.toml" "$MANAGER_CORE_DIR/src"

echo "[manager-api 1/3] Lint (ruff check)"
uv run --project "$MANAGER_API_DIR" ruff check "$MANAGER_API_DIR"

echo "[manager-api 2/3] Format (ruff format --check)"
uv run --project "$MANAGER_API_DIR" ruff format --check "$MANAGER_API_DIR"

echo "[manager-api 3/3] Type check (mypy)"
uv run --project "$MANAGER_API_DIR" mypy --config-file "$MANAGER_API_DIR/pyproject.toml" "$MANAGER_API_DIR/src"

echo "[manager-tui 1/3] Lint (ruff check)"
uv run --project "$MANAGER_TUI_DIR" ruff check "$MANAGER_TUI_DIR"

echo "[manager-tui 2/3] Format (ruff format --check)"
uv run --project "$MANAGER_TUI_DIR" ruff format --check "$MANAGER_TUI_DIR"

echo "[manager-tui 3/3] Type check (mypy)"
uv run --project "$MANAGER_TUI_DIR" mypy --config-file "$MANAGER_TUI_DIR/pyproject.toml" "$MANAGER_TUI_DIR/src"

# ── tests ─────────────────────────────────────────────────────────────────────
echo "[tests 1/7] gateway (pytest)"
uv run --project "$GATEWAY_DIR" pytest "$GATEWAY_DIR/tests" -v --tb=short \
  --cov="$GATEWAY_DIR/src" --cov-report=term-missing --cov-fail-under=80

echo "[tests 2/7] auth-service (pytest)"
(cd "$AUTH_DIR" && uv run pytest tests/ -v --tb=short)

echo "[tests 3/7] telemetry (pytest)"
uv run --project "$TELEMETRY_DIR" pytest "$TELEMETRY_DIR/tests" -v --tb=short \
  --cov="$TELEMETRY_DIR/src" --cov-report=term-missing --cov-fail-under=90

echo "[tests 4/7] runtime/manager/core (pytest)"
uv run --project "$MANAGER_CORE_DIR" pytest "$MANAGER_CORE_DIR/tests" -v --tb=short

echo "[tests 5/7] runtime/manager/api (pytest)"
uv run --project "$MANAGER_API_DIR" pytest "$MANAGER_API_DIR/tests" -v --tb=short

echo "[tests 6/7] runtime/manager/tui (pytest)"
uv run --project "$MANAGER_TUI_DIR" pytest "$MANAGER_TUI_DIR/tests" -v --tb=short

echo "[tests 7/7] runtime scripts (bash)"
bash "$RUNTIME_DIR/tests/test_runtime_scripts.sh"

echo "[tests 8/8] scripts/ (bash — spec 023)"
bash "$ROOT/scripts/tests/test_scripts_023.sh"

echo "--- All checks passed. Push allowed. ---"
