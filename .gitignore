*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
ENV/

# UV — lock file IS committed; only exclude the cache
.uv/
__pypackages__/

# Pytest / coverage / type-checking
.pytest_cache/
.coverage
htmlcov/
