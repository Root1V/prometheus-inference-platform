.ruff_cache/

# Secrets — never commit
.env
*.env
.env.*
!*.env.example
!.env.*.example
*.pem
*.key
# dev TLS certs (generated by gateway/certs/gen-dev-cert.sh)
*.crt
*.p12
*.pfx
secrets/

# Deploy state file (written by scripts/install-rhel.sh --deploy)
# Implements: memory/specs/024-idempotent-deploy.md — AC-4
.deploy-state

# Model weights — large binaries stored outside the repo
runtime/models/*.gguf
runtime/models/*.bin
runtime/models/*.pt
runtime/models/*.safetensors

# Manager runtime-generated files (logs + PID files)
runtime/logs/
runtime/run/

# RM-10: built admin dashboard SPA — regenerated by `npm run build` in
# gateway/admin-ui/ (or the Dockerfile's admin-ui-builder stage), not committed.
gateway/src/prometheus_gateway/admin/static/

# Docker
docker-compose.override.yml

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo
*.DS_Store
data/
