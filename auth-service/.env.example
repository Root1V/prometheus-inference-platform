# Prometheus Auth Service — Environment Variables
# Copy to auth-service/.env and fill in values. Never commit .env to version control.
# See specs/005-auth-service.md — Step 0 (Bootstrap) for key generation.

# ── RSA Key Pair ─────────────────────────────────────────────────────────────
# Container-internal paths — DO NOT CHANGE (match the volume targets in podman-compose.yml)
AUTH_PRIVATE_KEY_FILE=/run/secrets/jwt_private_key.pem
AUTH_PUBLIC_KEY_FILE=/run/secrets/jwt_public_key.pem
# kid tag — must match the filename stem of the active key pair (e.g. "2026-q1")
AUTH_ACTIVE_KID=2026-q1

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must match JWT_ISSUER in gateway/.env and AUTH_JWT_ISSUER in root .env — all three must be identical.
AUTH_JWT_ISSUER=https://prometheus-victor.internal

# ── Admin API ────────────────────────────────────────────────────────────────
# Required. Generate with: openssl rand -hex 32
AUTH_ADMIN_API_KEY=<replace-with-openssl-rand-hex-32>

# ── Database ─────────────────────────────────────────────────────────────────
# Container-internal path — matches the /data bind-mount in podman-compose.yml.
# Do NOT change this for Podman deployments.
AUTH_DB_URL=sqlite+aiosqlite:////data/auth.db
# For PostgreSQL: AUTH_DB_URL=postgresql+asyncpg://user:pass@host/db

# ── Redis (revocation) ───────────────────────────────────────────────────────
AUTH_REVOCATION_REDIS_URL=redis://redis:6379/0

# ── Rate Limiting ────────────────────────────────────────────────────────────
AUTH_RATE_LIMIT_RPM=10

# ── Role TTLs (seconds) — optional, defaults shown ───────────────────────────
# AUTH_TTL_ADMIN_SECONDS=10800     # 3 hours
# AUTH_TTL_COGNITIVE_SECONDS=3600  # 1 hour
# AUTH_TTL_AGENT_SECONDS=600       # 10 minutes
# AUTH_TTL_APP_SECONDS=300         # 5 minutes

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
# To disable tracing without code changes: OTEL_SDK_DISABLED=true

# ── TLS (specs/017-auth-service-tls.md) ──────────────────────────────────────
# Do NOT set AUTH_TLS_CERT_FILE / AUTH_TLS_KEY_FILE here for Podman deployments —
# podman-compose.yml overrides them to container-internal /run/secrets/ paths.
# For bare-metal usage, generate dev certs with: bash auth-service/certs/gen-dev-cert.sh

# ── TLS / CA bundle (RHEL) ───────────────────────────────────────────────────
# Set when behind a corporate TLS interception proxy (Zscaler or similar).
# On RHEL 9 this is the standard bundle path after update-ca-trust.
# On macOS or non-RHEL hosts, comment out or update to match the local bundle.
REQUESTS_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt
SSL_CERT_FILE=/etc/pki/tls/certs/ca-bundle.crt

# ── Credential share links (specs/016-credential-share-link.md) ──────────────
# Required. Generate with: openssl rand -hex 32
SHARE_TOKEN_ENCRYPTION_KEY=<replace-with-openssl-rand-hex-32>
# Optional. Default: 3600 (1 hour). Max: 86400 (24 hours).
# SHARE_TOKEN_TTL_SECONDS=3600
