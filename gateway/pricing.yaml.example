# Optional per-model pricing — copy to gateway/pricing.yaml to enable.
#
# Token prices are USD per 1,000,000 tokens. Prompt and completion tokens are
# usually priced differently, so both are required together per model (an
# entry with only one of the two is treated as unpriced for tokens).
# Image prices are USD per generated image, set independently via
# image_price (RM-60) — a model can have token pricing, image pricing, or
# both, but only image-modality models have anything to charge per-image for.
#
# A model id with no entry here simply shows no cost figure in the Usage
# page/API (never a silent $0) — GET /v1/usage's estimated_cost_usd is null
# for it. Safe to price only the models you actually want to track.
#
# Implements: docs/roadmap.md — RM-33 (pricing table + real cost).
# Implements: docs/roadmap.md — RM-60 (image pricing).

models:
  - id: gpt-oss-20b-mxfp4
    prompt_price_per_1m: 0.15
    completion_price_per_1m: 0.60

  - id: sd-turbo-image
    image_price: 0.02   # USD per generated image
