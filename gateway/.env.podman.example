# Prometheus Gateway — Podman Environment Variables
# Implements: specs/004-podman-containerization.md
#
# Copy to gateway/.env before running podman compose up.
# NEVER commit gateway/.env to version control.

# ── JWT / Auth ─────────────────────────────────────────────────────────────
JWT_ISSUER=https://prometheus-victor.internal 
JWT_AUDIENCE=prometheus-gateway
JWT_CLOCK_SKEW_SECONDS=30

# Key source: set ONE of the following.
# JWKS (preferred for Podman Compose — zero-downtime key rotation):
JWT_JWKS_URL=https://auth-service:9000/.well-known/jwks.json
# Static bind-mounted PEM (bare-metal / standalone dev — uncomment and remove JWT_JWKS_URL):
# JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public_key.pem

# Token revocation (Redis is on the internal Podman network)
JWT_REVOCATION_REDIS_URL=redis://redis:6379/0
# JWT_REVOCATION_STRICT=true   # fail-closed when Redis is unavailable

# ── llama.cpp backend ──────────────────────────────────────────────────────
# DEPRECATED — backend URLs are now set per-model in registry.yaml.
# (specs/006-multi-model-gateway.md — AC-10)
# LLAMA_CPP_URL=http://host.containers.internal:8080

# ── Manager REST API ────────────────────────────────────────────────────────
# The gateway queries this for the live registry (discovery + state).
# Register the client once via the auth-service admin API — see deployment.md § Step 2.
# The gateway auto-renews the token (300 s TTL, renewed 60 s before expiry).
MANAGER_URL=http://manager:8090
MANAGER_CLIENT_ID=<gateway-manager-sync-client-id>
MANAGER_CLIENT_SECRET=<gateway-manager-sync-client-secret>

# ── TLS (specs/013-web-chat-ui-proxy.md) ────────────────────────────────────
# For Podman Compose: DO NOT set these here — podman-compose.yml overrides them
# to container-internal /run/secrets/ paths via the environment: block.
# For bare-metal start.sh (no Podman): uncomment and set host paths.
# GATEWAY_TLS_CERT_FILE=/etc/prometheus/certs/gateway.crt
# GATEWAY_TLS_KEY_FILE=/etc/prometheus/certs/gateway.key

# ── CA bundle (RHEL 9 — required behind Zscaler/corporate proxy) ─────────────
# On RHEL 9 this is the standard bundle path after update-ca-trust.
# On macOS or non-RHEL hosts, comment out or update to match the local bundle.
#REQUESTS_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt
#SSL_CERT_FILE=/etc/pki/tls/certs/ca-bundle.crt

# ── Web Chat UI (specs/013-web-chat-ui-proxy.md) ────────────────────────────
UI_ENABLED=true
AUTH_SERVICE_TOKEN_URL=https://auth-service:9000/oauth2/token
# Self-signed cert in the Podman stack — disable internal TLS verification
AUTH_SERVICE_TLS_VERIFY=false

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
# To disable tracing without code changes: OTEL_SDK_DISABLED=true
